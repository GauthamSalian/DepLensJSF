# ==========================================
# DepLens Environment Template (.env.example)
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==========================================

# GitHub OAuth2 App Credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# JWT Configuration (30-day session = 2592000000 ms)
JWT_SECRET=your_base64_or_hex_256bit_secret_key_here
JWT_EXPIRATION_MS=2592000000

# MySQL Credentials
DB_USERNAME=root
DB_PASSWORD=
